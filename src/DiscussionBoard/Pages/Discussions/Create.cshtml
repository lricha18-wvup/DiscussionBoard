
@page "/Thread/Create/{forumId:int}"
@model DiscussionBoard.Pages.Discussions.Create


<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<div>
    <h1>New thread</h1>

    <form method="post">
        <input type="hidden" asp-for="ForumId" />
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <label asp-for="Input.Title"></label>
            <input asp-for="Input.Title"/>
            <span asp-validation-for="Input.Title"></span>
        </div>

        <div>
            <label asp-for="Input.Content"></label>
            <textarea asp-for="Input.Content"></textarea>
            <span asp-validation-for="Input.Content"></span>
        </div>

        <button type="submit">Create</button>
    </form>
</div>
</body>
</html>
