@page "/Discussion/{threadId:int}/Post/Edit/{postId:int}"
@model DiscussionBoard.Pages.Discussions.EditPostModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<h1>Edit post</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="Input.Title"></label>
        <input asp-for="Input.Title" />
        <span asp-validation-for="Input.Title"></span>
    </div>

    <div>
        <label asp-for="Input.Content"></label>
        <textarea asp-for="Input.Content"></textarea>
        <span asp-validation-for="Input.Content"></span>
    </div>

    <button type="submit">Save</button>
</form>
</html>
