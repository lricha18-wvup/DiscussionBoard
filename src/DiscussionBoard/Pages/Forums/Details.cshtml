@page "{id:int}"
@model DiscussionBoard.Pages.Forums.Details


<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<div>

    <h1>@Model.Forum.Name</h1>
    <p>@Model.Forum.Description</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/Discussions/Create" asp-route-forumId="@Model.Forum.Id">New thread</a>
    }

    <h3 class="mt-3">Discussions</h3>

    @foreach (var thread in Model.Threads)
    {
        <partial name="/Pages/Forums/_ThreadCard.cshtml" model="thread" />
    }
</div>
</body>
</html>
